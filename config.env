# Configurações da distro. Edite aqui e rode ./build.sh de novo.

DISTRO_NAME="extra-linux"
DISTRO_ID="extralinux"
DISTRO_VERSION="1.0"

# Base Debian (trixie = Debian 13, estável)
DEBIAN_SUITE="trixie"
ARCH="amd64"

# Idioma, teclado e fuso do sistema live
LOCALE="pt_BR.UTF-8"
KEYBOARD="br"
TIMEZONE="America/Sao_Paulo"

# Usuário do modo live (senha padrão: live)
LIVE_USER="live"
